export default{manifest:{id:"puff-worldbook-v1",name:"世界书工坊",version:"1.0.0",apiVersion:1,engine:"puff",app:{name:"世界书工坊",letter:"♡",icon:'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><text x="12" y="16" text-anchor="middle" font-size="14" style="fill:#ffffff;stroke:none">♡</text></svg>'}},setup(t){const puffCtx=t;/* ===== 等级判定内核 kit 开始 ===== */
function puffPT(t){
  var s=(t==null?'':''+t), re=/((?:[A-Za-z]{1,2}|[0-9]{1,3}|[一二三四五六七八九十]{1,3})[＋+\-－±]?)[ \t]*(级|阶|档|等|段|星)/g, m, out=[];
  while((m=re.exec(s))) out.push({label:(m[1]+m[2]).toUpperCase().replace(/－/g,'-').replace(/＋/g,'+'), at:m.index, end:re.lastIndex});
  return out;
}
function puffBare(v){
  var t=(v==null?'':''+v).replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'');
  var m=/^((?:[A-Za-z]{1,2}|[0-9]{1,3}|[一二三四五六七八九十]{1,3})[＋+\-－±]?)[ \t]*(级|阶|档|等|段|星)[ \t]*(.*)$/.exec(t);
  if(!m) return '';
  var lbl=(m[1]+m[2]).toUpperCase().replace(/－/g,'-').replace(/＋/g,'+'), rest=m[3].replace(/[ \t\u3000]+$/g,'');
  if(rest==='') return lbl;
  if(/^(?:以上|或以上|及以上|级别|等级|档|等|类|待遇|人员|水平)$/.test(rest)) return lbl+rest;
  return '';
}
function puffFieldLevel(text){
  var s=(text==null?'':''+text);
  var re=/(?:学院等级|等级|评级|位阶|阶级|阶层|分组|所属|学院身份|地位)[ \t]*[:：][ \t]*([^。\n；;]{0,60})/g, m, v, first='';
  while((m=re.exec(s))){ v=puffBare(m[1]); if(v){ if(!first) first=v; } }
  return first;
}
function puffSubLevel(text,pos){
  var lines=(text==null?'':''+text).split('\n'), i, acc=0, idx=0;
  for(i=0;i<lines.length;i++){ var next=acc+lines[i].length+1; if(pos<next){ idx=i; break; } acc=next; if(i===lines.length-1) idx=i; }
  for(i=idx-1;i>=0;i--){
    var ln=lines[i].replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'');
    if(!ln) { if(i<idx-4) break; else continue; }
    if(ln.length>32) continue;
    if(!/[：:][ \t]*$/.test(ln)) continue;
    var tags=puffPT(ln);
    return tags.length? tags[tags.length-1].label : '';
  }
  return '';
}
function puffTitleLevel(title){
  var s=(title==null?'':''+title);
  var tags=puffPT(s);
  if(tags.length!==1) return '';
  if(/(?:[A-Za-z]{1,2}|[0-9]{1,3}|[一二三四五六七八九十]{1,3})[＋+\-－±]?[ \t]*(?:至|到|~|～|—|－|\/|／)/.test(s)) return '';
  return tags[0].label;
}
function puffNamePos(content,name){
  var n=(name==null?'':''+name).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  if(!n) return -1;
  var m=new RegExp('^[ \\t\\u3000]*(?:姓名[:：][ \\t]*)?'+n+'[ \\t]*[（(][ \\t]*[A-Za-z][^)）]{1,30}[ \\t]*[)）]','m').exec(content);
  if(m) return m.index;
  var m2=new RegExp('^[ \\t\\u3000]*[A-Za-z][A-Za-z .\'’\\-]{1,30}[ \\t]*[（(][ \\t]*'+n+'[ \\t]*[）)]','m').exec(content);
  return m2? m2.index : -1;
}
function puffOwn(content,pos){
  var n=content.slice(pos), rest=n.slice(1);
  var cut=rest.search(/\n[ \t\u3000]*(?:[\u4e00-\u9fa5\u00b7·]{2,14}[ \t]*[（(][A-Za-z][^)）]{1,30}[)）]|[A-Za-z][A-Za-z .'’\-]{1,30}[ \t]*[（(][\u4e00-\u9fa5\u00b7·]{2,14}[)）])/);
  return cut<0? n : n.slice(0,cut+1);
}
function puffPick(entries,name){
  var best=null, hits=[];
  for(var i=0;i<(entries||[]).length;i++){
    var e=entries[i]||{}, content=(e.content==null?'':''+e.content), title=''+((e.title||e.name||''));
    var pos=puffNamePos(content,name);
    if(pos<0) continue;
    var own=puffOwn(content,pos), t=puffTitleLevel(title), f=puffFieldLevel(own), s=puffSubLevel(content,pos);
    var disg=/伪装身份/.test(own), w=0, label='', from='';
    if(t){ w=disg?2.5:3; label=t; from='条目标题'; }
    else if(f){ w=2; label=f; from='本人段落'; }
    else if(s){ w=1; label=s; from='所属小节'; }
    var rec={entry:title,label:label,from:from,w:w,own:own,tag:s,field:f,titleTag:t,disg:disg,subLine:puffSubLine(content,pos)};
    hits.push(rec);
    if(label&&(!best||w>best.w)) best=rec;
  }
  return {best:best,hits:hits};
}
/* ===== 等级判定内核 kit 结束 ===== */
function puffSubLine(text,pos){
  var lines=(text==null?'':''+text).split('\n'), i, acc=0, idx=0;
  for(i=0;i<lines.length;i++){ var next=acc+lines[i].length+1; if(pos<next){ idx=i; break; } acc=next; if(i===lines.length-1) idx=i; }
  for(i=idx-1;i>=0;i--){
    var ln=lines[i].replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'');
    if(!ln) continue;
    if(ln.length>32) continue;
    if(!/[：:][ \t]*$/.test(ln)) continue;
    return ln;
  }
  return '';
}
function puffFieldLine(own,label){
  var lines=(own==null?'':''+own).split('\n'), i;
  for(i=0;i<lines.length;i++) if(lines[i].indexOf(label)>-1) return lines[i].replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'');
  return (''+own).replace(/^[ \t\u3000]+/,'').split('\n')[0]||'';
}
function puffPeople(entries,stopRe){
  var set=new Map(), i, j, e, c, lines, ln, m, m2, cn, en;
  for(i=0;i<(entries||[]).length;i++){
    e=entries[i]||{}; c=(e.content==null?'':''+e.content); lines=c.split('\n');
    for(j=0;j<lines.length;j++){
      ln=lines[j]; cn=''; en='';
      m=/^[ \t\u3000]*([\u4e00-\u9fa5\u00b7·]{2,8})[ \t]*[（(][ \t]*([A-Za-z][A-Za-z .'’\-]{1,30})[ \t]*[）)]/.exec(ln);
      if(m){cn=m[1];en=m[2];}
      else{ m2=/^[ \t\u3000]*([A-Za-z][A-Za-z .'’\-]{1,30})[ \t]*[（(][ \t]*([\u4e00-\u9fa5\u00b7·]{2,8})[ \t]*[）)]/.exec(ln); if(m2){cn=m2[2];en=m2[1];} }
      if(!cn) continue;
      if(stopRe&&stopRe.test(cn)) continue;
      if(!set.has(cn)) set.set(cn,{name:cn,en:en});
      else if(en&&!set.get(cn).en) set.get(cn).en=en;
    }
  }
  return set;
}
function puffTable(entries){
  var stop=/^(人物设定|人际关系|人物关系|剧情触发|你的优势|真实动机|真实身份|核心秘密|奖励条件|奖励形式|惩罚触发|惩罚形式|对话示例|话术模板|命令|学院背景|区域划分|特殊待遇|阶级审判|未归类|姓名|备注|设定|介绍|概述|分级|规则|语言|公开|核心|层级概述|等级概述|阶级概述|世界观概述)$/;
  var map=puffPeople(entries,stop), rows=[];
  map.forEach(function(v){
    var k=puffPick(entries,v.name), ev=[], cf=[], best=k.best;
    k.hits.forEach(function(h){
      if(!h.label) return;
      if(best&&h.entry===best.entry&&h.from===best.from&&h.label===best.label){
        ev.push({entry:h.entry,label:h.label,from:h.from,quote:h.from==='条目标题'?('条目标题：'+h.entry):(h.from==='所属小节'?('小节标题：'+(h.subLine||h.tag)):puffFieldLine(h.own,h.label))});
      }else if(best&&h.label!==best.label){ cf.push({entry:h.entry,label:h.label,from:h.from}); }
    });
    rows.push({name:v.name,en:v.en,level:best?best.label:'',from:best?best.from:'',evidence:ev,conflict:cf});
  });
  rows.sort(function(a,b){return ((a.level||'zz')).localeCompare(b.level||'zz')||a.name.localeCompare(b.name)});
  return rows;
}

