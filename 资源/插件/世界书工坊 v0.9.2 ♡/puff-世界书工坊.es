function puffSections(content){
  var lines=(content==null?'':''+content).split('\n'), marks=[], i;
  var re1=/^[ \t\u3000]*([\u4e00-\u9fa5·]{2,8})[ \t]*[（(][ \t]*([A-Za-z][A-Za-z .'’\-]{1,30})[ \t]*[）)]/;
  var re2=/^[ \t\u3000]*([A-Za-z][A-Za-z .'’\-]{1,30})[ \t]*[（(][ \t]*([\u4e00-\u9fa5·]{2,8})[ \t]*[）)]/;
  for(i=0;i<lines.length;i++){ if(re1.test(lines[i])||re2.test(lines[i])) marks.push(i); }
  var secs=[], start=0;
  for(i=0;i<marks.length;i++){
    var m=marks[i], end=(i+1<marks.length)?marks[i+1]:lines.length;
    if(m>start) secs.push({header:'',text:lines.slice(start,m).join('\n')});
    secs.push({header:lines[m]||'',text:lines.slice(m,end).join('\n')});
    start=end;
  }
  if(start<lines.length) secs.push({header:'',text:lines.slice(start).join('\n')});
  if(!secs.length) secs.push({header:'',text:(content==null?'':''+content)});
  return secs;
}
function puffFieldKey(label){
  var L=(label==null?'':''+label).replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'').replace(/^[【\[]|[】\]]$/g,'');
  var map={身份:'id',职业:'id',关系:'rel',人际关系:'rel',性格:'char',性格特点:'char',外貌:'look',外貌穿搭:'look',穿着:'look',年龄:'age',语气:'voice',说话风格:'voice',口吻:'voice',边界:'bnd',禁忌:'bnd',底线:'bnd',雷点:'bnd',性别:'gender',生日:'birthday',语言:'language',分组:'group',别名:'aliases',姓名:'displayName',名字:'displayName',称呼:'aliases',英文名:'en',英文:'en',name:'displayName'};
  if(map[L]) return map[L];
  if(/等级|评级|阶位|级别|位阶|阶级|阶层|档次/.test(L)) return 'level';
  if(/身份|地位|职位|阵营|势力|门派|宗门/.test(L)) return 'id';
  if(/性格|性情|脾气/.test(L)) return 'char';
  if(/外貌|容貌|长相|穿着|发色|瞳色/.test(L)) return 'look';
  if(/语气|口吻|说话|语癖/.test(L)) return 'voice';
  if(/边界|禁忌|底线|雷点/.test(L)) return 'bnd';
  if(/年龄/.test(L)) return 'age';
  if(/关系|人际/.test(L)) return 'rel';
  return '';
}

function puffFakeName(n){
  var v=(n==null?'':''+n).replace(/^[ \t\u3000]+|[ \t\u3000]+$/g,'');
  if(!v) return true;
  if(/^(?:最在意|在意|性格|性格特点|性别|性别年龄|身份|身份地位|学院身份|学院等级|等级|评级|阶位|级别|位阶|阶级|阶层|关系|人际关系|外貌|外貌穿搭|穿着|年龄|语气|语气风格|口吻|说话风格|边界|禁忌|底线|雷点|备注|来源|称呼|别名|昵称|生日|语言|设定|简介|概述|介绍|名字|姓名|职业|阵营|势力|门派|宗门|种族|族属|出身|职位|归属|血统|特点|特征|爱好|弱点|目标|立场|态度|概览|总览|总纲|索引|目录|规则|说明|提示|注意|警告|前言|序言|引言|导语)$/.test(v)) return true;
  return false;
}
function puffAgg(name,aliases,entries){
  var nms=[], i, j;
  [name].concat(aliases||[]).forEach(function(x){ var v=(x==null?'':''+x).trim(); if(!v) return; for(var k=0;k<nms.length;k++) if(puffSame(nms[k],v)) return; nms.push(v); });
  var addNm=function(v){ v=(v==null?'':''+v).trim(); if(!v) return; for(var k=0;k<nms.length;k++) if(puffSame(nms[k],v)) return; nms.push(v); };
  for(i=0;i<(entries||[]).length;i++){
    var c0=(entries[i]&&entries[i].content!=null?'':'')+(entries[i]&&entries[i].content!=null?''+entries[i].content:'');
    if(!c0) continue;
    for(j=0;j<nms.length;j++){
      var nm0=nms[j]; if(!nm0) continue;
      var esc=nm0.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
      try{
        var m1=new RegExp(esc+'[ \\t]*[（(][ \\t]*([A-Za-z][A-Za-z .\'’\\-]{1,30})[ \\t]*[)）]').exec(c0);
        if(m1&&m1[1]) addNm(m1[1].replace(/\s+/g,' '));
        var m2=new RegExp('([A-Za-z][A-Za-z .\'’\\-]{1,30})[ \\t]*[（(][ \\t]*'+esc+'[ \\t]*[)）]').exec(c0);
        if(m2&&m2[1]) addNm(m2[1].replace(/\s+/g,' '));
      }catch(e){}
    }
  }
  function puffSame(a,b){ return a.toLowerCase()===b.toLowerCase(); }
  var blocks=[], fields={}, seen={};
  for(i=0;i<(entries||[]).length;i++){
    var e=entries[i]||{}, title=(''+(e.title||e.name||'')).trim(), content=''+(e.content||'');
    if(!content) continue;
    var secs=puffSections(content), picked=[], isProfile=false;
    for(j=0;j<secs.length;j++){
      var sec=secs[j]||{}, t=''+(sec.text||'');
      if(!t.trim()) continue;
      var hit='';
      for(var q=0;q<nms.length;q++){ if(t.indexOf(nms[q])>=0){ hit=nms[q]; break; } }
      if(!hit) continue;
      var lines=t.split('\n'), head=lines[0]||'', headHit=false;
      for(var w=0;w<nms.length;w++){ if(head.indexOf(nms[w])>=0 && /[（(]/.test(head)){ headHit=true; break; } }
      if(headHit){ picked.push(t.trim()); isProfile=true; }
      else {
        var keep=[];
        lines.forEach(function(ln){
          var hitN='';
          for(var w=0;w<nms.length;w++){ if(ln.indexOf(nms[w])>=0){ hitN=nms[w]; break; } }
          if(!hitN) return;
          var v=ln.replace(/^[ \t\u3000·•\-—*]+/,'').trim();
          var rest=v;
          nms.forEach(function(x){ rest=rest.split(x).join(''); });
          if(/[A-Z][a-z]+\s+[A-Z][a-z]+/.test(rest)){
            var parts=v.split(/[，,]/), keepParts=[];
            parts.forEach(function(p){ if(nms.some(function(x){return p.indexOf(x)>=0})) keepParts.push(p.trim()); });
            if(keepParts.length) v=keepParts.join('，');
          }
          keep.push(v);
        });
        if(!keep.length){
          t.split(/(?<=[。；;！？!?])/).forEach(function(sn){ for(var w=0;w<nms.length;w++){ if(sn.indexOf(nms[w])>=0){ keep.push(sn.trim()); break; } } });
        }
        if(keep.length) picked.push(keep.join('\n'));
      }
    }
    if(!picked.length) continue;
    var text=picked.join('\n').replace(/\n{3,}/g,'\n\n').trim();
    if(!text) continue;
    var key=title+'|'+text.slice(0,60);
    if(seen[key]) continue; seen[key]=1;
    blocks.push({title:title,text:text,profile:isProfile});
    text.split('\n').forEach(function(ln){
      var m=/^[ \t\u3000]*([^\s：:]{1,12})[ \t]*[：:][ \t]*(.+?)[ \t]*$/.exec(ln);
      if(!m) return;
      var k=puffFieldKey(m[1]);
      if(k && !(k in fields)) fields[k]=m[2];
    });
  }
  blocks.sort(function(a,b){ return (b.profile?1:0)-(a.profile?1:0) || b.text.length-a.text.length; });
  return {blocks:blocks,fields:fields};
}
