      "css": "/* ============================================================\n   Puff · 复古 iOS 蓝色 · 带标注完整版\n   ============================================================\n   ★ 顶栏：真正可见的是 .chat-thread-pill；\n   ★ 气泡：改 .chat-bubble 的 background 即可换色；\n   ★ 尾巴：用原图，颜色在图片里，不要试图用 CSS 改；\n   ★ 语音气泡：改 .puff-voice-pill，与文字气泡保持同色；\n   ★ 顶部注释里 👈 标记的数值是最常调的位置。\n   ============================================================ */\n\n\n/* ============================================================\n   A. 顶栏（保持蓝色 · 顶边贴紧 + 名字居中 + 左右留白）\n   ============================================================ */\n\n/* 聊天滚动区左右留白：让头像和气泡一起往中间收 */\n.chat-thread-scroll {\n  padding-left: 12px !important;   /* 👈 数值越大，整体往中间缩得越多 */\n  padding-right: 12px !important;\n}\n\n/* 移动“我”的头像上下位置（只影响我方） */\n.chat-msg.is-me .chat-ava,\n.chat-msg.is-me .chat-ava-sm {\n  transform: translateY(8px) !important;   /* 👈 负数往上，正数往下 */\n}\n\n/* —— 1. 顶栏主体 —— */\n.chat-thread .chat-thread-pill {\n  /* 👇 从上到下的渐变：B6C4D8 → 5E779A（蓝） */\n  background: linear-gradient(180deg, #B6C4D8 0%, #5E779A 100%) !important;\n\n  border: none !important;\n  /* 👇 底边 4px 粗的 475C7F */\n  border-bottom: 4px solid #475C7F !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n\n  /* 强制吸附屏幕顶部 */\n  position: fixed !important;\n  top: 0 !important;\n  left: 0 !important;\n  right: 0 !important;\n\n  margin: 0 !important;\n  width: auto !important;\n\n  /* 上边距：避开状态栏 */\n  padding-top: calc(env(safe-area-inset-top, 0px) + 6px) !important;\n  padding-bottom: 6px !important;\n  padding-left: 16px !important;\n  padding-right: 16px !important;\n\n  /* 顶栏整体高度（只改这里） */\n  height: 80px !important;\n  box-sizing: border-box !important;\n\n  /* 按钮垂直居中 */\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n\n  color: #ffffff !important;\n  z-index: 100 !important;\n}\n\n/* —— 2. 名字：强制水平居中（绝对定位） —— */\n.chat-thread .chat-thread-center {\n  position: absolute !important;\n  left: 50% !important;\n  transform: translateX(-50%) !important;\n  top: 15px !important;\n  height: 100% !important;\n\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n\n  max-width: 60% !important;\n  margin-left: 0 !important;   /* 👈 名字左右微调：正数往右，负数往左 */\n}\n\n.chat-thread .chat-thread-center h2 {\n  margin: 0 !important;\n  padding: 0 !important;\n  line-height: 1.2 !important;\n\n  /* 👇 名字改成白色 */\n  color: #ffffff !important;\n\n  /* 极淡的深色投影，白色在浅蓝上更有层次 */\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15) !important;\n}\n\n/* —— 3. 返回按钮 —— */\n.chat-thread .chat-back,\n.chat-thread .chat-back-wrap {\n  background: transparent !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  overflow: visible !important;\n  flex-shrink: 0 !important;\n}\n.chat-thread .chat-back {\n  background-image: url(\"https://imgbed.heliar.top/i/QEyEz44Ec8R8CdvE_1790970853196_CocoAI_20261003_035508_2.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  color: transparent !important;\n  font-size: 0 !important;\n\n  /* 基准尺寸固定，实际大小靠 scale 控制 */\n  width: 40px !important;\n  height: 40px !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  overflow: visible !important;\n\n  /* 👈 整体放大缩小：只改这个数字（2 = 视觉 80px） */\n  transform: scale(2) !important;\n  transform-origin: left center !important;\n\n  /* 👈 按钮上下位置：负数往上，正数往下 */\n  margin-top: -10px !important;\n\n  /* 👈 按钮亮度：0.7 最暗，1.0 原始亮度 */\n  filter: brightness(0.90) !important;\n}\n\n/* —— 4. 更多按钮 —— */\n.chat-thread .chat-thread-head-more {\n  background-image: url(\"https://imgbed.heliar.top/i/I3655-xngGsY4EeG_1790970852640_CocoAI_20261003_035506_1.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  color: transparent !important;\n  font-size: 0 !important;\n\n  width: 40px !important;\n  height: 40px !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  overflow: visible !important;\n  flex-shrink: 0 !important;\n\n  /* 👈 与返回按钮保持一致 */\n  transform: scale(1.6) !important;\n  transform-origin: right center !important;\n  margin-top: -10px !important;\n  filter: brightness(0.90) !important;\n}\n\n/* —— 5. 心声按钮：隐藏图标 —— */\n.chat-thread .chat-thread-head-xinsheng {\n  opacity: 0 !important;\n  pointer-events: auto !important;\n}\n\n/* —— 6. 隐藏按钮内部残留 —— */\n.chat-thread .chat-back > *,\n.chat-thread .chat-thread-head-more > *,\n.chat-thread .chat-thread-head-xinsheng > * {\n  display: none !important;\n}\n\n\n/* ============================================================\n   B. 底栏（scale 放大回复按钮，不撑高）\n   ============================================================ */\n\n/* —— 1. 底栏总容器 —— */\n.chat-thread .chat-compose {\n  background: #E6E6E6 !important;\n  border-top: 4px solid #FDFFFE !important;\n  border-left: none !important;\n  border-right: none !important;\n  border-bottom: none !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n\n  padding: 14px 0 !important;\n  position: relative !important;\n  overflow: visible !important;\n}\n\n/* —— 2. 中间大框：清空默认尺寸 —— */\n.chat-thread .chat-compose-bar {\n  background: transparent !important;\n  background-color: transparent !important;\n  background-image: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  outline: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  width: 100% !important;\n  min-height: 0 !important;\n  height: auto !important;\n  display: flex !important;\n  align-items: center !important;\n}\n\n/* —— 3. 输入框：右端往左收靠 margin-right 正值 —— */\n.chat-thread .chat-compose-input {\n  background: #F5F5F5 !important;\n  border-radius: 999px !important;\n  border: 1px solid #8C8C8C !important;\n  box-shadow:\n    inset 0 2px 4px rgba(0, 0, 0, 0.25),\n    inset 0 -1px 0 rgba(255, 255, 255, 0.9),\n    0 0 0 1px rgba(255, 255, 255, 0.6) !important;\n\n  color: #1a1a1a !important;\n\n  /* 👈 右侧 90px 是留给按钮的空间，想一行装更多字就调小 */\n  padding: 6px 90px 6px 12px !important;\n  margin-right: 15px !important;\n  margin-left: 0 !important;\n\n  flex: 1 1 auto !important;\n  min-width: 80px !important;\n\n  height: auto !important;\n  min-height: 0 !important;\n  max-height: none !important;\n  line-height: 1.4 !important;\n  box-sizing: border-box !important;\n  outline: none !important;\n}\n\n/* —— 4. 加号按钮 —— */\n.chat-thread .chat-compose-plus {\n  background-image: url(\"https://imgbed.heliar.top/i/arUY_CHNWyvKnMA3_1790890020070_CocoAI_20261002_052732_1.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n\n  width: 32px !important;\n  height: 32px !important;\n  font-size: 0 !important;\n  color: transparent !important;\n  border: none !important;\n  overflow: visible !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n\n  transform: translateY(-2px) !important;\n}\n.chat-thread .chat-compose-plus > * {\n  display: none !important;\n}\n\n/* —— 5. 语音按钮 —— */\n.chat-thread .chat-compose-icon.is-voice {\n  width: 24px !important;\n  height: 24px !important;\n  border: none !important;\n  overflow: visible !important;\n  position: relative !important;\n  z-index: 2 !important;\n  /* 👈 语音按钮位置：改这两个数值 */\n  transform: translate(-50px, 0px) !important;\n}\n.chat-thread .chat-compose-icon.is-voice > * {\n  display: none !important;\n}\n\n/* —— 6. 回复按钮：保持 24px，用 scale 视觉放大 —— */\n.chat-thread .chat-compose-icon.is-reply {\n  background-image: url(\"https://imgbed.heliar.top/i/1wg9KU_LSPVe_nGq_1790890321315_CocoAI_20261002_053238_1.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n\n  width: 24px !important;\n  height: 24px !important;\n\n  font-size: 0 !important;\n  color: transparent !important;\n  border: none !important;\n  overflow: visible !important;\n\n  /* 👈 位置 + 放大：改 scale 改大小，改 translate 改位置 */\n  transform: translate(-23px, 0px) scale(3.3) !important;\n  transform-origin: center center !important;\n\n  position: relative !important;\n  z-index: 5 !important;\n}\n.chat-thread .chat-compose-icon.is-reply > * {\n  display: none !important;\n}\n\n\n/* ============================================================\n   C. 气泡（蓝色 8CBFFC → B7E2FF，尾巴用原图带边框）\n   ============================================================ */\n\n/* --- 1. 我方气泡 --- */\n.chat-msg.is-me {\n  position: relative !important;\n}\n\n.chat-msg.is-me .chat-bubble {\n  position: relative !important;\n  overflow: visible !important;\n  z-index: 1 !important;\n\n  /* 👇 气泡渐变：上面浅蓝，下面深蓝 */\n  background: linear-gradient(\n    180deg,\n    #8CBFFC 0%,\n    #B7E2FF 100%\n  );\n\n  border: 1px solid #1D2B43 !important;\n  border-radius: 16px !important;\n  color: #000000;\n  /* ⚠️ 内阴影会压暗底部颜色，如果想和尾巴更融合可以改成 none */\n  box-shadow: inset 0 -6px 10px rgba(0, 0, 0, 0.15) !important;\n\n  padding: 10px 15px !important;\n\n  width: fit-content !important;\n  min-width: 60px;\n}\n\n/* 我方高光（顶部更亮一档） */\n.chat-msg.is-me .chat-bubble::before {\n  content: \"\";\n  position: absolute;\n  top: 0.5px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: calc(100% - 16px);\n  height: 14px;\n  background: linear-gradient(180deg, #E0E9FD 0%, #AFD3FD 100%);\n  border-radius: 8px;\n  pointer-events: none;\n  z-index: -1;\n  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);\n}\n\n/* 我方容器 */\n.chat-msg.is-me .chat-msg-body {\n  position: relative !important;\n  overflow: visible !important;\n}\n\n/* 我方尾巴 —— 用原图（自带边框），颜色和气泡一致 */\n.chat-msg.is-me .chat-bubble::after {\n  content: \"\";\n  position: absolute;\n  right: -60px;\n  bottom: -52px;\n  width: 70px;\n  height: 70px;\n  transform-origin: right bottom;\n  transform: scale(1.8);\n  z-index: 2 !important;\n  clip-path: inset(-2px 0 -2px 0);\n  margin-right: -4px;\n  margin-bottom: -4px;\n\n  background-image: url(\"https://imgbed.heliar.top/i/8J4A9gYmMXCFQXIv_1790954108829.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: right bottom !important;\n\n  box-shadow: none !important;\n  border: none !important;\n  pointer-events: none;\n}\n\n\n/* --- 2. 对方气泡（灰色，保持不变） --- */\n.chat-msg.is-them {\n  position: relative !important;\n}\n\n.chat-msg.is-them .chat-bubble {\n  position: relative !important;\n  overflow: visible !important;\n  z-index: 1 !important;\n\n  background: linear-gradient(\n    180deg,\n    #DCDCDC 0%,\n    #DBDBDB 100%\n  );\n\n  border: 1.2px solid #646464 !important;\n  border-radius: 16px !important;\n  color: #000000;\n  box-shadow: inset 0 -6px 10px rgba(0, 0, 0, 0.08) !important;\n\n  padding: 10px 15px !important;\n  width: fit-content !important;\n  min-width: 60px;\n}\n\n.chat-msg.is-them .chat-bubble::before {\n  content: \"\";\n  position: absolute;\n  top: 0.5px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: calc(100% - 16px);\n  height: 14px;\n  background: linear-gradient(180deg, #F5F5F5 0%, #E7E7E7 100%);\n  border-radius: 8px;\n  pointer-events: none;\n  z-index: -1;\n  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 1);\n}\n\n.chat-msg.is-them .chat-msg-body {\n  position: relative !important;\n  overflow: visible !important;\n}\n\n/* 对方尾巴 —— 灰色原图 */\n.chat-msg.is-them .chat-bubble::after {\n  content: \"\";\n  position: absolute;\n  left: -69px;\n  bottom: -63px;\n  width: 72px;\n  height: 72px;\n  transform-origin: left bottom;\n  transform: scale(2.0);\n  z-index: 2 !important;\n  clip-path: inset(-2px 0 -2px 0);\n  margin-left: -4px;\n  margin-bottom: -4px;\n\n  background-image: url(\"https://imgbed.heliar.top/i/tckxq5RvcAt_Mc3W_1790955392433.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: left bottom !important;\n\n  box-shadow: none !important;\n  border: none !important;\n  pointer-events: none;\n}\n\n\n/* ============================================================\n   D. 翻译文本（挂在气泡上方 · 黑底白字）\n   ============================================================ */\n\n/* 气泡允许内容溢出，并作为定位参照 */\n.chat-bubble {\n  position: relative !important;\n  overflow: visible !important;\n}\n\n/* 有翻译的气泡，顶部留出翻译的空间 */\n.chat-bubble:has(.chat-bubble-trans-inline),\n.chat-bubble:has(.chat-bubble-trans-chip) {\n  margin-top: 24px !important;\n}\n\n/* 翻译块：从气泡上边缘外侧开始 */\n.chat-bubble-trans-inline,\n.chat-bubble-trans-chip {\n  position: absolute !important;\n  bottom: calc(80% + 1px) !important;\n  top: auto !important;\n\n  display: block !important;\n\n  /* 黑底白字 */\n  background: #000000 !important;\n  color: #ffffff !important;\n\n  /* 👈 小字号，改这里 */\n  font-size: 10px !important;\n  line-height: 1.3 !important;\n\n  padding: 1px 4px !important;\n  border-radius: 2px !important;\n\n  /* 👈 一行最大宽度，越大装越多字 */\n  width: max-content !important;\n  max-width: 240px !important;\n\n  word-break: break-word !important;\n  white-space: normal !important;\n\n  border: none !important;\n  box-shadow: none !important;\n  text-shadow: none !important;\n  z-index: 2 !important;\n}\n\n/* 对方气泡上方：翻译靠左 */\n.chat-msg.is-them .chat-bubble-trans-inline,\n.chat-msg.is-them .chat-bubble-trans-chip {\n  left: 0 !important;\n  right: auto !important;\n}\n\n/* 我方气泡上方：翻译靠右 */\n.chat-msg.is-me .chat-bubble-trans-inline,\n.chat-msg.is-me .chat-bubble-trans-chip {\n  right: 0 !important;\n  left: auto !important;\n}\n\n/* chip 内部标签也保持白字、同步字号 */\n.chat-bubble-trans-chip-label {\n  color: #ffffff !important;\n  background: transparent !important;\n  font-size: 10px !important;\n  line-height: 1.3 !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  border: none !important;\n}\n\n/* 夜间模式保持黑底白字 */\nhtml[data-theme=\"dark\"] .chat-bubble-trans-inline,\nhtml[data-theme=\"dark\"] .chat-bubble-trans-chip {\n  background: #000000 !important;\n  color: #ffffff !important;\n}\nhtml[data-theme=\"dark\"] .chat-bubble-trans-chip-label {\n  color: #ffffff !important;\n}\n\n/* 干掉翻译分割线 */\n.chat-bubble-trans-rule {\n  display: none !important;\n}\n\n\n/* ============================================================\n   E. 转账卡片（拟态版 · 日间浅灰 / 夜间深灰）\n   ============================================================ */\n\n.chat-msg.is-me .puff-transfer,\n.chat-msg.is-them .puff-transfer,\n.chat-msg.has-transfer .puff-transfer,\n.chat-msg.has-transfer .chat-msg-body > div[class*=\"transfer\"] {\n  position: relative !important;\n  overflow: visible !important;\n  z-index: 1 !important;\n\n  background: #EBEEF3 !important;\n  border-radius: 16px !important;\n\n  border: none !important;\n  outline: none !important;\n\n  padding: 14px 18px !important;\n  min-width: 170px !important;\n  max-width: 250px !important;\n\n  /* 👇 拟态双阴影：右下暗、左上亮 */\n  box-shadow:\n    3px 3px 8px rgba(163, 177, 198, 0.45),\n    -2px -2px 5px rgba(255, 255, 255, 0.55),\n    inset 0.5px 0.5px 1px rgba(255, 255, 255, 0.55),\n    inset -0.5px -0.5px 1px rgba(0, 0, 0, 0.03) !important;\n}\n\n/* 干掉旧版残留的高光与尾巴 */\n.chat-msg .puff-transfer::before,\n.chat-msg .puff-transfer::after {\n  display: none !important;\n}\n.chat-msg.has-transfer .chat-msg-body > div::after {\n  display: none !important;\n}\n\n/* 转账内部排版 */\n.chat-msg .puff-transfer .puff-transfer-title {\n  font-size: 12px !important;\n  color: #8E9AAB !important;\n  margin-bottom: 6px !important;\n  letter-spacing: 0.5px !important;\n}\n\n.chat-msg .puff-transfer .puff-transfer-amount {\n  font-size: 26px !important;\n  font-weight: 700 !important;\n  color: #4A5568 !important;\n  letter-spacing: 1px !important;\n  line-height: 1.2 !important;\n  margin-bottom: 6px !important;\n  text-shadow:\n    1px 1px 2px rgba(255, 255, 255, 0.9),\n    -1px -1px 1px rgba(0, 0, 0, 0.1) !important;\n}\n.chat-msg .puff-transfer .puff-transfer-amount::before {\n  content: \"¥\" !important;\n  font-size: 15px !important;\n  font-weight: 600 !important;\n  margin-right: 3px !important;\n  opacity: 0.7 !important;\n}\n\n.chat-msg .puff-transfer .puff-transfer-note {\n  font-size: 11px !important;\n  color: #9AA8BC !important;\n  margin-top: 8px !important;\n  padding-top: 8px !important;\n  border-top: none !important;\n  box-shadow:\n    inset 0 1.5px 2px rgba(163, 177, 198, 0.4),\n    inset 0 -1px 0 rgba(255, 255, 255, 0.8) !important;\n}\n\n.chat-msg .puff-transfer .puff-transfer-status {\n  font-size: 10px !important;\n  color: #A8B4C4 !important;\n  margin-top: 4px !important;\n}\n\n/* 日间模式：卡片内文字全部黑色 */\n.chat-msg .puff-transfer,\n.chat-msg .puff-transfer * {\n  color: #000000 !important;\n}\n.chat-msg .puff-transfer .puff-transfer-title,\n.chat-msg .puff-transfer .puff-transfer-note,\n.chat-msg .puff-transfer .puff-transfer-status,\n.chat-msg .puff-transfer .puff-transfer-amount {\n  color: #000000 !important;\n}\n.chat-msg .puff-transfer .puff-transfer-amount {\n  text-shadow:\n    1px 1px 2px rgba(255, 255, 255, 0.9),\n    -1px -1px 1px rgba(0, 0, 0, 0.1) !important;\n}\n\n/* 夜间模式：阴影加强 + 文字全白 */\nhtml[data-theme=\"dark\"] .chat-msg.is-me .puff-transfer,\nhtml[data-theme=\"dark\"] .chat-msg.is-them .puff-transfer,\nhtml[data-theme=\"dark\"] .chat-msg.has-transfer .puff-transfer {\n  background: #2A2D31 !important;\n\n  /* 黑影更深、白影更亮，立体感才出来 */\n  box-shadow:\n    4px 4px 10px rgba(0, 0, 0, 0.75),\n    -3px -3px 7px rgba(255, 255, 255, 0.08),\n    inset 0.5px 0.5px 1px rgba(255, 255, 255, 0.08),\n    inset -0.5px -0.5px 1px rgba(0, 0, 0, 0.5) !important;\n}\n\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer,\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer * {\n  color: #FFFFFF !important;\n}\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer .puff-transfer-title {\n  color: rgba(255, 255, 255, 0.7) !important;\n}\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer .puff-transfer-note {\n  color: rgba(255, 255, 255, 0.65) !important;\n  box-shadow:\n    inset 0 1.5px 2px rgba(0, 0, 0, 0.5),\n    inset 0 -1px 0 rgba(255, 255, 255, 0.06) !important;\n}\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer .puff-transfer-status {\n  color: rgba(255, 255, 255, 0.55) !important;\n}\nhtml[data-theme=\"dark\"] .chat-msg .puff-transfer .puff-transfer-amount {\n  color: #FFFFFF !important;\n  text-shadow:\n    1px 1px 2px rgba(0, 0, 0, 0.6),\n    -1px -1px 1px rgba(255, 255, 255, 0.05) !important;\n}\n\n\n/* ============================================================\n   F. 语音气泡（与文字气泡同款 · 蓝色）\n   ============================================================ */\n\n/* 我方语音气泡（蓝色） */\n.chat-msg.is-me .puff-voice-pill {\n  position: relative !important;\n  overflow: visible !important;\n  z-index: 1 !important;\n\n  background: linear-gradient(180deg, #8CBFFC 0%, #B7E2FF 100%) !important;\n  border: 1px solid #1D2B43 !important;\n  border-radius: 16px !important;\n  color: #000000 !important;\n  box-shadow: inset 0 -6px 10px rgba(0, 0, 0, 0.15) !important;\n\n  padding: 10px 15px !important;\n  width: fit-content !important;\n  min-width: 60px !important;\n}\n\n.chat-msg.is-me .puff-voice-pill::before {\n  content: \"\";\n  position: absolute;\n  top: 0.5px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: calc(100% - 16px);\n  height: 14px;\n  background: linear-gradient(180deg, #E0E9FD 0%, #AFD3FD 100%);\n  border-radius: 8px;\n  pointer-events: none;\n  z-index: -1;\n  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);\n}\n\n/* 对方语音气泡（灰色） */\n.chat-msg.is-them .puff-voice-pill {\n  position: relative !important;\n  overflow: visible !important;\n  z-index: 1 !important;\n\n  background: linear-gradient(180deg, #DCDCDC 0%, #DBDBDB 100%) !important;\n  border: 1.2px solid #646464 !important;\n  border-radius: 16px !important;\n  color: #000000 !important;\n  box-shadow: inset 0 -6px 10px rgba(0, 0, 0, 0.08) !important;\n\n  padding: 10px 15px !important;\n  width: fit-content !important;\n  min-width: 60px !important;\n}\n\n.chat-msg.is-them .puff-voice-pill::before {\n  content: \"\";\n  position: absolute;\n  top: 0.5px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: calc(100% - 16px);\n  height: 14px;\n  background: linear-gradient(180deg, #F5F5F5 0%, #E7E7E7 100%);\n  border-radius: 8px;\n  pointer-events: none;\n  z-index: -1;\n  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 1);\n}\n\n/* 内部元素跟着气泡配色走 */\n.chat-msg .puff-voice-pill .puff-voice-dur,\n.chat-msg .puff-voice-pill .puff-voice-glyph {\n  color: #000000 !important;\n}\n\n/* 容器透明，只给单根波形条染色 */\n.chat-msg .puff-voice-pill .puff-voice-waves {\n  background: transparent !important;\n  background-color: transparent !important;\n}\n.chat-msg .puff-voice-pill .puff-voice-wave {\n  background-color: #000000 !important;\n}\n\n/* 尾巴防裁切（整条链路放开 overflow） */\n.chat-msg.has-voice,\n.chat-msg.has-voice .chat-msg-body,\n.chat-msg.has-voice .chat-swipe-host,\n.chat-msg.has-voice .chat-swipe-content,\n.chat-msg.has-voice .puff-voice-pill {\n  overflow: visible !important;\n}\n\n/* 我方语音尾巴 —— 原图（自带边框） */\n.chat-msg.is-me .puff-voice-pill::after {\n  content: \"\";\n  position: absolute;\n  right: -60px;\n  bottom: -52px;\n  width: 70px;\n  height: 70px;\n  transform-origin: right bottom;\n  transform: scale(1.8);\n  z-index: 2 !important;\n  clip-path: inset(-2px 0 -2px 0);\n  margin-right: -4px;\n  margin-bottom: -4px;\n\n  background-image: url(\"https://imgbed.heliar.top/i/8J4A9gYmMXCFQXIv_1790954108829.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: right bottom !important;\n\n  box-shadow: none !important;\n  border: none !important;\n  pointer-events: none;\n}\n\n/* 对方语音尾巴 —— 灰色原图 */\n.chat-msg.is-them .puff-voice-pill::after {\n  content: \"\";\n  position: absolute;\n  left: -69px;\n  bottom: -63px;\n  width: 72px;\n  height: 72px;\n  transform-origin: left bottom;\n  transform: scale(2.0);\n  z-index: 2 !important;\n  clip-path: inset(-2px 0 -2px 0);\n  margin-left: -4px;\n  margin-bottom: -4px;\n\n  background-image: url(\"https://imgbed.heliar.top/i/tckxq5RvcAt_Mc3W_1790955392433.png\") !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: left bottom !important;\n\n  box-shadow: none !important;\n  border: none !important;\n  pointer-events: none;\n}\n\n\n/* ============================================================\n   G. 名字、时间戳、引用、头像\n   ============================================================ */\n\n/* 隐藏角色名字 */\n.chat-msg-name,\nspan.chat-msg-name {\n  display: none !important;\n}\n\n/* 时间戳：加粗 + 左侧添加 Read（样式完全一致） */\n.chat-msg-time,\ntime.chat-msg-time {\n  color: #858C99 !important;\n\n  /* 立体感阴影（浮雕效果） */\n  text-shadow:\n    0 1px 1px rgba(0, 0, 0, 0.15),\n    0 -1px 1px rgba(255, 255, 255, 0.8) !important;\n\n  /* 👈 字体加粗 + 放大，想要更粗改 1000，更细改 700 */\n  font-weight: 1000 !important;\n  font-size: 11px !important;\n  letter-spacing: 0.5px !important;\n}\n\n/* 在时间戳左侧添加英文 Read，完全继承上方样式 */\n.chat-msg-time::before,\ntime.chat-msg-time::before {\n  content: \"Read\" !important;\n  margin-right: 5px !important;\n}\n\nhtml[data-theme=\"dark\"] .chat-msg-time,\nhtml[data-theme=\"dark\"] time.chat-msg-time {\n  color: #858C99 !important;\n  text-shadow: none !important;\n}\n\n/* 引用文字颜色与气泡文字保持一致 */\n.chat-qq-quote .chat-qq-quote-text,\n.chat-qq-quote .chat-qq-quote-name {\n  color: #000000 !important;\n  opacity: 1 !important;\n}\nhtml[data-theme=\"dark\"] .chat-qq-quote .chat-qq-quote-text,\nhtml[data-theme=\"dark\"] .chat-qq-quote .chat-qq-quote-name {\n  color: #ffffff !important;\n}"
