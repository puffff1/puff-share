          "mode": "code",
          "html": "<div class=\"student-archive-widget\" id=\"idWidget\">\n    <div class=\"id-card\">\n        <!-- 左侧照片区 -->\n        <div class=\"photo-wrap\" id=\"photoWrap\">\n            <input type=\"file\" accept=\"image/*\" class=\"file-input\" id=\"fileInput\">\n            <img src=\"{{img1}}\" alt=\"avatar\" id=\"avatarImg\">\n            <div class=\"photo-placeholder\" id=\"photoPlaceholder\">PHOTO AREA</div>\n            <div class=\"sign-text\">\n                <span class=\"editable-text\" id=\"signVal\">Be myself</span>\n            </div>\n        </div>\n\n        <!-- 右侧信息区 -->\n        <div class=\"info-wrap\">\n            <div class=\"title-main\">Student Archive</div>\n            <div class=\"sub-line\">\n                <span>SYSTEM AUTHORIZED</span>\n                <span>//</span>\n            </div>\n            <div class=\"class-text\">CLASS 01</div>\n            <div class=\"divider\"></div>\n\n            <div class=\"info-item\">\n                <div class=\"info-label\">NAME / 姓名</div>\n                <div class=\"info-value\">\n                    <span class=\"editable-text\" id=\"nameVal\">shuyu</span>\n                </div>\n            </div>\n\n            <div class=\"info-item\">\n                <div class=\"info-label\">ID NUMBER / 学号</div>\n                <div class=\"info-value\">\n                    <span class=\"editable-text\" id=\"idVal\">19-2364</span>\n                </div>\n            </div>\n\n            <div class=\"info-item\">\n                <div class=\"info-label\">DEPARTMENT / 院系</div>\n                <div class=\"info-value\">\n                    <span class=\"editable-text\" id=\"deptVal\">Finance</span>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n(async function initStudentIDWidget() {\n    var W = window.widget;\n\n    function getWidgetData(key, defaultVal) {\n        if (!W) return Promise.resolve(defaultVal);\n        return Promise.resolve(W.getState(key)).then(function (val) {\n            return (val !== null && val !== undefined && val !== '') ? val : defaultVal;\n        }).catch(function () { return defaultVal; });\n    }\n    function setWidgetData(key, value) {\n        if (!W) return Promise.resolve();\n        return Promise.resolve(W.setState(key, value));\n    }\n\n    var avatarImg = document.getElementById('avatarImg');\n    var photoPlaceholder = document.getElementById('photoPlaceholder');\n    var signEl = document.getElementById('signVal');\n    var nameEl = document.getElementById('nameVal');\n    var idEl = document.getElementById('idVal');\n    var deptEl = document.getElementById('deptVal');\n    var fileInput = document.getElementById('fileInput');\n\n    avatarImg.onload = function () { photoPlaceholder.style.display = 'none'; };\n\n    function applyConfig(cfg) {\n        signEl.textContent = cfg.signText;\n        nameEl.textContent = cfg.nameText;\n        idEl.textContent = cfg.idText;\n        deptEl.textContent = cfg.deptText;\n        if (cfg.avatar) avatarImg.src = cfg.avatar;\n    }\n\n    function onReady(cb) { if (W && W.onReady) W.onReady(cb); else cb(); }\n\n    onReady(function () {\n        Promise.all([\n            getWidgetData('avatar', null),\n            getWidgetData('signText', 'Be myself'),\n            getWidgetData('nameText', 'shuyu'),\n            getWidgetData('idText', '19-2364'),\n            getWidgetData('deptText', 'Finance')\n        ]).then(function (r) {\n            applyConfig({ avatar: r[0], signText: r[1], nameText: r[2], idText: r[3], deptText: r[4] });\n        });\n    });\n\n    fileInput.addEventListener('change', function (e) {\n        var file = e.target.files[0];\n        if (!file) return;\n        var reader = new FileReader();\n        reader.onload = function (event) {\n            var imgData = event.target.result;\n            avatarImg.src = imgData;\n            photoPlaceholder.style.display = 'none';\n            setWidgetData('avatar', imgData);\n        };\n        reader.readAsDataURL(file);\n    });\n\n    function makeEditable(el, key) {\n        el.addEventListener('click', function () {\n            var currentText = el.textContent;\n            var input = document.createElement('input');\n            input.type = 'text';\n            input.value = currentText;\n            el.textContent = '';\n            el.appendChild(input);\n            input.focus();\n            input.select();\n            function save() {\n                var newText = input.value.trim() || currentText;\n                el.textContent = newText;\n                setWidgetData(key, newText);\n            }\n            input.addEventListener('blur', save);\n            input.addEventListener('keydown', function (e) {\n                if (e.key === 'Enter') input.blur();\n            });\n        });\n    }\n\n    makeEditable(signEl, 'signText');\n    makeEditable(nameEl, 'nameText');\n    makeEditable(idEl, 'idText');\n    makeEditable(deptEl, 'deptText');\n})();\n</script>",
          "css": "/* ================= 根容器 ================= */\n.student-archive-widget {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    padding: 1.5% !important;\n    background: transparent !important;\n    font-family: \"Times New Roman\", system-ui, sans-serif;\n    overflow: hidden !important;\n}\n\n/* ================= 学生证卡片 ================= */\n.id-card {\n    width: 100% !important;\n    height: 100% !important;\n    background: #1c1c1e !important;\n    border-radius: 18px !important;\n    box-sizing: border-box !important;\n    padding: 3.5% !important;\n    display: flex !important;\n    flex-direction: row !important;\n    align-items: stretch !important;\n    justify-content: space-between !important;\n    border: 1px solid rgba(255,255,255,0.08) !important;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.25) !important;\n    overflow: hidden !important;\n}\n\n/* ================= 左侧照片区 ================= */\n.photo-wrap {\n    flex: 0 0 26% !important;\n    width: 26% !important;\n    height: 100% !important;\n    position: relative !important;\n    border: 1px dashed rgba(255,255,255,0.22) !important;\n    border-radius: 4px !important;\n    overflow: hidden !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    cursor: pointer;\n}\n\n.photo-wrap img {\n    width: 100% !important;\n    height: 100% !important;\n    object-fit: cover !important;\n}\n\n.photo-placeholder {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: rgba(255,255,255,0.35);\n    font-size: clamp(0.6rem, 1.2vw, 0.85rem);\n    text-align: center;\n    pointer-events: none;\n}\n\n.sign-text {\n    position: absolute !important;\n    bottom: 2px !important;\n    left: 50% !important;\n    transform: translateX(-50%) !important;\n    font-style: italic !important;\n    font-size: clamp(0.55rem, 1.5vw, 0.95rem) !important;\n    color: rgba(255,255,255,0.75) !important;\n    font-family: serif !important;\n    white-space: nowrap !important;\n    z-index: 2;\n}\n\n.sign-text span {\n    cursor: pointer;\n    padding: 2px 4px;\n    border-radius: 4px;\n    transition: background 0.2s;\n}\n\n.sign-text span:hover {\n    background: rgba(255,255,255,0.08);\n}\n\n/* ================= 右侧信息区 ================= */\n.info-wrap {\n    flex: 1 1 auto !important;\n    width: 70% !important;\n    height: 100% !important;\n    margin-left: 3.5% !important;\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: center !important;\n    gap: clamp(3px, 1vw, 10px) !important;\n    color: #ffffff !important;\n    overflow: hidden !important;\n}\n\n.title-main {\n    font-size: clamp(1.15rem, 3.2vw, 2.2rem) !important;\n    font-weight: 500 !important;\n    white-space: nowrap !important;\n    overflow: hidden !important;\n    text-overflow: ellipsis !important;\n}\n\n.sub-line {\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: center !important;\n    font-size: clamp(0.65rem, 1.3vw, 0.9rem) !important;\n    color: rgba(255,255,255,0.65) !important;\n    white-space: nowrap !important;\n}\n\n.class-text {\n    font-size: clamp(0.95rem, 2.4vw, 1.7rem) !important;\n    font-weight: 600 !important;\n    letter-spacing: 1px !important;\n    white-space: nowrap !important;\n}\n\n.divider {\n    width: 100% !important;\n    height: 1px !important;\n    background: rgba(255,255,255,0.18) !important;\n    margin: clamp(2px, 0.5vw, 5px) 0 !important;\n}\n\n/* =================【核心：横向一行布局 标签左，内容右】================= */\n.info-item {\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: baseline !important;\n    gap: 8px !important;\n}\n\n.info-label {\n    font-size: clamp(0.55rem, 1vw, 0.8rem) !important;\n    color: rgba(255,255,255,0.45) !important;\n    letter-spacing: 2px !important;\n    text-transform: uppercase !important;\n    white-space: nowrap !important;\n    flex-shrink: 0;\n}\n/* ✅ 关键：info-value 和 label 样式统一（颜色、字重对齐，视觉一致） */\n.info-value {\n    font-size: clamp(0.7rem, 1.3vw, 1rem) !important; \n    font-weight: 500 !important; \n    color: #ffffff !important; \n    white-space: nowrap !important;\n    overflow: visible !important;\n    text-align: right !important;\n}\n\n.editable-text {\n    cursor: pointer;\n    padding: 2px 4px;\n    border-radius: 4px;\n    transition: background 0.2s;\n}\n\n.editable-text:hover {\n    background: rgba(255,255,255,0.08);\n}\n\n.info-value input {\n    background: #2a2a2e;\n    color: #ffffff;\n    border: 1px solid rgba(255,255,255,0.15);\n    border-radius: 4px;\n    padding: 2px 6px;\n    font-size: inherit;\n    width: auto !important;\n    box-sizing: border-box;\n    text-align: right;\n}\n\n.file-input {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    cursor: pointer;\n}"
